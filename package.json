{
  "name": "ssf-merge",
  "version": "0.0.0",
  "private": true,
  "description": "Mail merge for PowerPoint: one template block, one slide set per row, formatting preserved.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:count": "node scripts/test-count.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "build:lib": "tsc -p tsconfig.lib.json",
    "probe": "node scripts/build-probe.mjs",
    "answers": "node scripts/read-answers.mjs",
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/office-js": "^1.0.607",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
