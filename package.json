{
  "name": "ssf-merge",
  "version": "0.3.0",
  "private": true,
  "description": "Mail merge for PowerPoint: one template block, one slide set per row, formatting preserved.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:count": "node scripts/test-count.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "build:lib": "tsc -p tsconfig.lib.json",
    "probe": "node scripts/build-probe.mjs",
    "answers": "node scripts/read-answers.mjs",
    "dev": "vite",
    "build": "vite build",
    "icons": "node scripts/build-icons.mjs",
    "manifests": "node scripts/build-manifests.mjs",
    "release:check": "node scripts/check-release.mjs",
    "sibling-watch": "node scripts/sibling-watch.mjs",
    "audit-floors": "node scripts/audit-floors.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/office-js": "^1.0.616",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
