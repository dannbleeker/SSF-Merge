{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "id": "43ebbbac-44ad-42b2-a582-0ef079093e6c",
  "version": "1.0.1.0",
  "name": {
    "short": "SSF Merge",
    "full": "SSF Merge for PowerPoint"
  },
  "description": {
    "short": "One template block of slides, one set per row of your data.",
    "full": "Mail merge for PowerPoint. Mark a block of slides as your template, attach a table, and get one set of slides per row with every font, colour and placement intact."
  },
  "developer": {
    "name": "StruktureretSundFornuft",
    "websiteUrl": "https://struktureretsundfornuft.dk",
    "privacyUrl": "https://ssf-merge.struktureretsundfornuft.dk/privacy.html",
    "termsOfUseUrl": "https://support.office.com/client/61994a3b-2c87-41c4-a88d-a6455efa362d"
  },
  "icons": {
    "outline": "assets/icon-outline-32.png",
    "color": "assets/icon-64.png"
  },
  "accentColor": "#00254C",
  "localizationInfo": {
    "defaultLanguageTag": "en-us"
  },
  "validDomains": [
    "ssf-merge.struktureretsundfornuft.dk"
  ],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "Document.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "extensions": [
    {
      "runtimes": [
        {
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://ssf-merge.struktureretsundfornuft.dk/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "ShowTaskpane",
              "type": "openPage",
              "pinnable": false,
              "view": "dashboard"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": [
            "default"
          ],
          "tabs": [
            {
              "builtInTabId": "TabHome",
              "groups": [
                {
                  "id": "SsfMerge.Group",
                  "label": "SSF Merge",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://ssf-merge.struktureretsundfornuft.dk/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://ssf-merge.struktureretsundfornuft.dk/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://ssf-merge.struktureretsundfornuft.dk/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "SsfMerge.OpenPane",
                      "type": "button",
                      "label": "Mail merge",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://ssf-merge.struktureretsundfornuft.dk/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://ssf-merge.struktureretsundfornuft.dk/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://ssf-merge.struktureretsundfornuft.dk/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Mail merge",
                        "description": "Open SSF Merge to mark a template block and merge your data into it."
                      },
                      "actionId": "ShowTaskpane"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
